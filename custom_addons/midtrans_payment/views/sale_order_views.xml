<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sale_order_form_midtrans" model="ir.ui.view">

        <field name="name">sale.order.form.midtrans</field>

        <field name="model">sale.order</field>

        <field name="inherit_id" ref="sale.view_order_form" />

        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">

                <button
                    name="action_dummy_midtrans"
                    type="object"
                    string="Pay with Midtrans"
                    invisible="midtrans_status == 'settlement'" />

                <button
                    name="action_check_midtrans_status"
                    type="object"
                    string="Check Midtrans Status"
                    invisible="not midtrans_order_id" />

            </xpath>

            <xpath expr="//sheet" position="inside">

                <group string="Midtrans Payment">

                    <field
                        name="midtrans_status"
                        readonly="1" />

                    <field
                        name="midtrans_order_id"
                        readonly="1" />

                    <field
                        name="midtrans_payment_url"
                        readonly="1" />

                </group>

            </xpath>

        </field>
    </record>
</odoo>